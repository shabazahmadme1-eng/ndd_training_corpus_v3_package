[{"urn": "urn:mavedb:00001201-a-1", "title": "TSC2 functional assay using prime editing in HAP1s", "shortDescription": "A curated loci prime editing (cliPE) approach to generate functional scores on over 200 variants in the TSC2 gene", "publishedDate": "2024-07-10", "replacesId": null, "numVariants": 208, "experiment": {"title": "Multimodal framework to resolve variants of uncertain significance in TSC2", "shortDescription": "Using genome editing in the endogenous TSC2 locus paired with a functional assay to determine function of known pathogenic, benign, and variants of uncertain significance.", "abstractText": "We developed Tuberous sclerosis classifier to Resolve variants of Uncertain Significance in TSC2 (TRUST), a machine learning model to predict pathogenicity of TSC2 missense VUS. To test whether these predictions are accurate, we further introduce curated loci prime editing (cliPE) as an accessible strategy for performing scalable multiplexed assays of variant effect (MAVEs). Using cliPE, we tested the effects of more than 200 TSC2 variants, including 106 VUS. ", "methodText": "The gDNA of the fixed, FACS-sorted HAP1 cells was extracted using the PureLink\u2122 Genomic DNA Mini Kit (Invitrogen #K182002). Manufacturer\u2019s instructions were followed with the exception of an added incubation (40-60 minutes, 90\u00b0C) to reverse formaldehyde-induced crosslinks. The target regions of TSC2 were then amplified via PCR (Bio-Rad iProof system), followed by an additional barcoding PCR reaction. The locus was then sequenced via shortread amplicon sequencing (Illumina MiniSeq System; 100,000 minimum read-depth). Reads were aligned to the human genome (hg38) and variant allele frequencies were calculated using the jellyfish k-mer counting package. Variants with allele frequency below 0.1% in unsorted cells were filtered out. Variant allele frequencies were then used to calculate a functional (enrichment) score using the Enrich2 statistical framework. Functional scores were then\nnormalized across exons. The normalized functional score is referred to as the constitutive mTORC1 activity score (CMAS).", "extraMetadata": {}, "recordType": "Experiment", "urn": "urn:mavedb:00001201-a", "createdBy": {"orcidId": "0000-0003-0554-2231", "firstName": "Jeffrey", "lastName": "Calhoun", "recordType": "User"}, "modifiedBy": {"orcidId": "0000-0003-0554-2231", "firstName": "Jeffrey", "lastName": "Calhoun", "recordType": "User"}, "creationDate": "2024-06-11", "modificationDate": "2024-07-10", "publishedDate": "2024-07-10", "experimentSetUrn": "urn:mavedb:00001201", "doiIdentifiers": [{"identifier": "10.1101/2024.06.07.597916", "id": 62, "recordType": "DoiIdentifier", "url": "https://doi.org/10.1101/2024.06.07.597916"}], "primaryPublicationIdentifiers": [], "secondaryPublicationIdentifiers": [], "rawReadIdentifiers": [], "contributors": [], "keywords": [], "scoreSetUrns": ["urn:mavedb:00001201-a-1"], "externalLinks": {}, "numScoreSets": 1, "processingState": null, "officialCollections": []}, "primaryPublicationIdentifiers": [], "secondaryPublicationIdentifiers": [], "license": {"longName": "CC0 (Public domain)", "shortName": "CC0", "active": true, "link": "https://creativecommons.org/publicdomain/zero/1.0/", "version": "1.0", "id": 1, "recordType": "ShortLicense"}, "creationDate": "2024-07-09", "modificationDate": "2024-12-16", "targetGenes": [{"name": "TSC2", "category": "protein_coding", "externalIdentifiers": [], "id": 4196, "recordType": "ShortTargetGene", "targetSequence": {"sequenceType": "dna", "sequence": "", "label": "TSC2", "recordType": "SavedTargetSequence", "taxonomy": {"code": 9606, "organismName": "Homo sapiens", "commonName": "human", "rank": "SPECIES", "hasDescribedSpeciesName": true, "articleReference": "NCBI:txid9606", "genomeIdentifierId": 5, "id": 15, "recordType": "Taxonomy", "url": "https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=info&id=9606"}}, "targetAccession": null, "mappedHgncName": null, "uniprotIdFromM