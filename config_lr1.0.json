{
  "model": "mipo",
  "hidden": 128,
  "mechanisms": 8,
  "field_layers": 3,
  "sequence_layers": 2,
  "anchors": 16,
  "window_radius": 25,
  "max_nodes": 256,
  "neighbors": 16,
  "max_conformers": 4,
  "structure": true,
  "global_kernel": true,
  "chemistry": true,
  "use_llr": true,
  "require_llr": true,
  "dropout": 0.1,
  "modality_dropout": 0.1,
  "batch_size": 8,
  "grad_accum": 4,
  "steps_per_epoch": 3000,
  "epochs": 20,
  "lr": 0.0003,
  "seed": 42,
  "ranking_weight": 0.2,
  "patience": 6,
  "amp": false,
  "max_abs_target": 20.0,
  "task_balanced_sampling": true,
  "contrast_fraction": 0.0,
  "contrast_weight": 0.0,
  "llr_residual": false,
  "meta_learning": false,
  "head_shrinkage": 0.0,
  "min_calibration_genes": 3,
  "structure_confidence_threshold": 0.5,
  "selection_metric": "macro_gene_spearman",
  "min_validation_genes": 5
